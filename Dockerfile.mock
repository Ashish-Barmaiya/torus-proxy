# syntax=docker/dockerfile:1

FROM golang:1.26 AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV CGO_ENABLED=0

RUN go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/mock-backend \
    ./cmd/mock-backend

FROM gcr.io/distroless/static-debian12

COPY --from=builder /out/mock-backend /usr/local/bin/mock-backend

ENTRYPOINT ["/usr/local/bin/mock-backend"]
